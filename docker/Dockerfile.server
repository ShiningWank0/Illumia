# syntax=docker/dockerfile:1

FROM node:22-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS web

WORKDIR /app/web

COPY web/package.json web/package-lock.json ./
# dependency lifecycle script は既定で実行しない。Vite 8 は esbuild install script に依存しない。
RUN npm ci --ignore-scripts

COPY web/ ./
RUN npm run build


# runtime (bookworm) と glibc を一致させるため -bookworm を明示する
FROM rust:1.98-slim-bookworm@sha256:94e9efa4033213dbb70d4f665527e7ece3944ddb7ba1dd2e43f6fd6e2490af58 AS rust

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        perl \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ ./crates/

RUN --mount=type=cache,id=illumia-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=illumia-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=illumia-cargo-target,target=/app/target,sharing=locked \
    cargo build --locked --release -p illumia-server \
    && install -Dm755 target/release/illumia-server /out/illumia-server


FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818 AS runtime

ARG SOURCE_COMMIT=unknown

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 illumia \
    && useradd --uid 1000 --gid 1000 --create-home --shell /usr/sbin/nologin illumia \
    && mkdir -p /app/web /data \
    && chown -R illumia:illumia /app /data \
    && chmod 0755 /app /app/web \
    && chmod 0700 /data

COPY --from=rust --chown=illumia:illumia /out/illumia-server /app/illumia-server
COPY --from=web --chown=illumia:illumia /app/web/build/ /app/web/

ENV ILLUMIA_DATA_DIR=/data \
    ILLUMIA_ADDR=0.0.0.0:2283 \
    ILLUMIA_WEB_DIST=/app/web \
    ILLUMIA_SECURE_COOKIES=true

LABEL org.opencontainers.image.source="https://github.com/ShiningWank0/Illumia" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.licenses="MIT"

VOLUME ["/data"]
EXPOSE 2283

USER 1000:1000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD bash -c '</dev/tcp/127.0.0.1/2283' || exit 1

STOPSIGNAL SIGTERM
ENTRYPOINT ["/app/illumia-server"]
