{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Illumia",
  "version": "0.1.0",
  "identifier": "com.shiningwank0.illumia",
  "build": {
    "frontendDist": "../../../web/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Illumia",
        "width": 420,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["apk"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {}
}
